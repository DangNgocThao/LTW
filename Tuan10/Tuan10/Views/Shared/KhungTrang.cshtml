<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-3">
                <a href="/KhachHang"><img src="~/HinhAnhSP/Logo.png" /></a>
            </div>
            <div class="col-5">
                <ul class="nav navbar">
                    <li class="nav-item">
                        <a href="/KhachHang" class="nav-link">Trang Chủ</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link">Đăng Ký</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link">Đăng Nhập</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link">Liên Hệ</a>
                    </li>
                </ul>
            </div>
            <div class="col text-right">
                <input type="text" placeholder="Search" />
                <img src="~/HinhAnhSP/Search.png" />
                <select class="btn btn-dark">
                    <option>Languages</option>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-3">
                @Html.Action("DSChuDe","KhachHang")
                @Html.Action("DSNXB", "KhachHang")
            </div>
            <div class="col">
                @RenderBody()
            </div>
        </div>
    </div>
</body>
</html>
