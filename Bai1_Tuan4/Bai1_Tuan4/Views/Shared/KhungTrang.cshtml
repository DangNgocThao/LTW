<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/bootstrap/css/dinhdang.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">
        <div class="row bg-danger border pt-3 pb-1">
            <div class="col-3">
                <h2 class="text-white text-right">NGUYEN KIM</h2>
            </div>
            <div class="col-4">
                <form action="/Home/XLTimKiem" method="post" class="form-inline">
                    <input type="text" name="txtTuKhoa" class="pr-0 w-75" placeholder="Bạn cần tìm gì hôm nay"/>
                    <input type="submit" class="bg-warning border-0" value="     " style="background-image: url(Images/img_search.jpg);background-repeat:no-repeat;background-position:center;height:30px;"/>
                </form>
            </div>
            <div class="col-1">
                <a href="#" class="text-white">
                    <img src="~/Images/img_giohang.jpg" />
                    Giỏ hàng
                </a>
            </div>
            <div class="col-1">
                <a href="#" class="text-white">
                    <img src="~/Images/img_login.jpg" />
                    Tài khoản
                </a>
            </div>
            <div class="col text-white">
                <div class="row">
                    <div class="col-1">
                        <img src="~/Images/img_giohang.jpg" />
                    </div>
                    <div class="col">
                        Hotline: 1800 6800 (Miễn phí)<br />
                        Mua hàng - Góp ý - Bảo hành
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <ul class="nav navbar cap0">
                    <li class="nav-item">
                        <div class="dropdown">
                            <a id="dropdownMenuButton" data-toggle="dropdown">Danh mục sản phẩm</a>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <a class="dropdown-item" href="#">Sản phẩm cùng hãng</a>
                            </div>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">Miễn phí giao lắp</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">Cẩm nang khuyến mãi</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">Hướng dẫn mua hàng online</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">Thương hiệu nổi bật</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="row">@RenderBody()</div>
    <div class="row">
        <div class="col-6">
            <p class="border-bottom border-danger h2">Sản phẩm cùng phân khúc giá</p>
            <div class="row">
                <div class="col">
                    <div class="card">
                        <img class="card-img-top" src="~/Images/img_SP.jpg" />
                        <div class="card-body">
                            <p>Smart Tivi Samsung HD 32 inch UA32T4500AKXXV</p>
                            <p><b class="text-danger">7.890.000đ</b> <del class="text-secondary"><small>8.000.000đ</small></del></p>
                            <p><small>Tiết kiệm 110.000đ</small></p>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card">
                        <img class="card-img-top" src="~/Images/img_product4.jpg" />
                        <div class="card-body">
                            <p>Smart Tivi Samsung Crystal UHD 4K 43 inch UA43T9000KXXV</p>
                            <p><b class="text-danger">13.390.000đ</b> <del class="text-secondary"><small>15.000.000đ</small></del></p>
                            <p><small>Tiết kiệm 2.510.000đ</small></p>
                        </div>
                    </div>
                </div>
            </div>        
        </div>
        <div class="col"></div>
    </div>
    <script src="~/bootstrap/js/jquery-3.3.1.min.js"></script>
    <script src="~/bootstrap/js/bootstrap.js"></script>
</body>
</html>
