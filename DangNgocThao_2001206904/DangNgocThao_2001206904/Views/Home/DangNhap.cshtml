
@{
    ViewBag.Title = "DangNhap";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<h2 class="text-center">Đăng Nhập</h2>
<div class="row">
    <div class="col-3"></div>
    <div class="col-6">
        <form action="/Home/XLDangNhap" method="post">
            <div class="form-outline mb-4">
                <label class="form-label">Số điện thoại</label>
                <input type="text" name="txtName" class="form-control" placeholder="Số điện thoại" />
            </div>

            <div class="form-outline mb-4">
                <label class="form-label">Password</label>
                <input type="password" name="txtPass" id="pass" class="form-control" placeholder="Mật khẩu" />
            </div>
            <button type="submit" class="btn btn-success btn-block mb-4">Đăng nhập</button>
        </form>
    </div>
    <div class="col-3"></div>
</div>