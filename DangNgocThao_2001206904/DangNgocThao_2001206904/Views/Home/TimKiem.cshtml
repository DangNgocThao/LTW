@model List<DangNgocThao_2001206904.Models.Loai>

@{
    ViewBag.Title = "TimKiem";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<p class="mt-3 ml-3">Tìm Kiếm</p>

<form action="/Home/TimKiem" method="post" class="pl-3 pt-3 w-75">
    <div class="border p-3">
        <div class="form-inline mb-4">
            <label class="form-label font-weight-bold">Tìm kiếm:</label>
            <input name="txtten" type="text" class="form-control w-50 ml-1" placeholder="Cà chua" />
        </div>

        <div class="form-inline mb-4">
            <label class="form-label font-weight-bold">Loại</label>
            <select class="form-control w-75 ml-5" name="txtma">
                @foreach (var item in Model)
                {
                    <option value="@item.MaLoai">@item.TenLoai</option>
                }
            </select>
        </div>
        <div class="form-inline mb-4">
            <input type="checkbox" id="searchmota" class="form-control" name="mota" />
            <label for="searchmota" class="font-weight-bold form-label ml-1">Tìm trong phần miêu tả sản phẩm</label>
        </div>
    </div>
    <div class="text-center">
        <button type="submit" class="btn btn-success mt-3 text-center">Tìm kiếm</button>
    </div>
</form>
