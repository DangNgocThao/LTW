@model DangNgocThao_2001206904.Models.KhachHang

@{
    ViewBag.Title = "XacNhanDH";
    Layout = "~/Views/Shared/Layout.cshtml";
}

@{
    if (Model == null)
    {
        <h2 class="text-center">Chưa đăng nhập</h2>
    }
    else
    {
    <h5 class="mt-2 text-warning">XÁC NHẬN ĐẶT HÀNG</h5>

    <form action="/Home/XuLyDH" method="post" class="border pl-3 pt-3 w-50 pr-4">
        THÔNG TIN KHÁCH HÀNG
        <div class="form-inline mb-4 mt-3">
            @{
                if (Model.GioiTinh == true)
                {
                    <input type="radio" id="male" name="gioi" class="form-control" checked />
                    <label for="male" class="form-label">Anh</label>
                    <input type="radio" id="female" name="gioi" class="form-control ml-3" />
                    <label for="female" class="form-label">Chị</label>
                }
                else
                {
                    <input type="radio" id="male" name="gioi" class="form-control" />
                    <label for="male" class="form-label">Anh</label>
                    <input type="radio" id="female" name="gioi" class="form-control ml-3" checked/>
                    <label for="female" class="form-label">Chị</label>
                }
            }
        </div>

        <div class="form-inline mb-4">
            <input type="text" class="form-control" value="@Model.TenKH"/>
            <input type="text" class="form-control ml-3" value="@Model.DienThoai"/>
        </div>
        CHỌN CÁCH THỨC NHẬN HÀNG
        <div class="form-outline mb-4 mt-3">
            <select class="form-control" name="cboHinhThucGH">
                <option value="Nhận tại siêu thị">Nhận tại siêu thị</option>
                <option value="Nhận hàng tại nhà">Nhận hàng tại nhà</option>
                <option value="Nhận hàng tại cửa hàng đại diện">Nhận hàng tại cửa hàng đại diện</option>
            </select>
            <input type="text" placeholder="Yêu cầu khác (không bắt buộc)" class="form-control mt-3" name="ghichu"/>
            <input value="ĐẶT HÀNG" type="submit" class="btn btn-warning mt-3 text-white w-100 font-weight-bold"></input>
        </div>
    </form>
    }
}