
@{
    ViewBag.Title = "GioHang";
    Layout = "~/Views/Shared/LayoutQuanLy.cshtml";
}
@using Tuan10.Models;
@model List<item>
@if (Model.Count == 0)
{
    <h2 class="text-center">Không có sản phẩm nào trong giỏ hàng!</h2> 
}
else
{
<table class="table">
   <thead class="thead-dark">
        <tr>
            <th>
                Mã sản phẩm
            </th>
            <th>
                Tên Sản phẩm
            </th>
            <th>
                Đơn giá
            </th>
            <th>
                Hình ảnh
            </th>
            <th>
                Mô tả
            </th>
            <th>
                Số lượng
            </th>
            <th></th>
    </tr>
   </thead>

@foreach (var item in Model) {
    <tr>
        <td class="border-top">
            @Html.DisplayFor(modelItem => item.ma)
        </td>
        <td class="border-top">
            @Html.DisplayFor(modelItem => item.ten)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.gia)
        </td>
        <td>
            <img src="/hinh/@item.hinh" width="100" height="100"/>
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.moTa)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.soluong)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.ma }) |
            @Html.ActionLink("Details", "Details", new { id=item.ma }) |
            @Html.ActionLink("Delete", "XoaGioHang", new { id=item.ma })
        </td>
    </tr>
}

</table>
}

