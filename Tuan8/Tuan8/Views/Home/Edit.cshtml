@model Tuan8.Models.Theloaitin

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using (Html.BeginForm("Edit","Home",FormMethod.Post,Model.IDLoai)) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <fieldset>
        <legend>Theloaitin</legend>

        @Html.HiddenFor(model => model.IDLoai)

        <div class="editor-label">
            @Html.LabelFor(model => model.Tentheloai)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.Tentheloai)
            @Html.ValidationMessageFor(model => model.Tentheloai)
        </div>

        <p>
            <input type="submit" value="Save" />
        </p>
    </fieldset>
}

<div>
    @Html.ActionLink("Back to List", "DSTheLoaiTin")
</div>
