@{
    ViewBag.Title = "dangNhap";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<h2 class="text-center">Đăng Nhập</h2>
<div class="row">
    <div class="col-3"></div>
    <div class="col-6">
        <form action="/Home/xlDangNhap" method="post">
            <div class="form-ouline mb-4">
                <label class="form-label">Số điện thoại</label>
                <input type="text" name="sdt" class="form-control" />
            </div>

            <div class="form-ouline mb-4">
                <label class="form-label">Mật khẩu</label>
                <input type="password" name="mk" class="form-control" />
            </div>
            <button type="submit" class="btn btn-success mb-4 w-100">Đăng nhập</button>
        </form>
    </div>
    <div class="col-3"></div>
</div>
