@model IEnumerable<Thao_DangNgoc_2001206904_BTVNTuan8.Models.tbl_Employee>

@{
    ViewBag.Title = "Details";
}
<link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

<h2 class="text-center text-primary">Chi tiết @ViewBag.ten</h2>
<table class="table">
    <thead class="thead-dark">
        <tr>
            <th>
                Mã nhân viên
            </th>
            <th>
                Tên nhân viên
            </th>
            <th>
                Giới Tính
            </th>
            <th>
                Địa chỉ
            </th>
            <th>
                Hình đại diện
            </th>
            <th>
                Mã phòng ban
            </th>
        </tr>
    </thead>

    @foreach (var item in Model)
    {
        <tr>
            <td class="border">
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td class="border">
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td class="border">
                @Html.DisplayFor(modelItem => item.Gender)
            </td>
            <td class="border">
                @Html.DisplayFor(modelItem => item.City)
            </td>
            <td class="border">
                @Html.DisplayFor(modelItem => item.Image)
            </td>
            <td class="border">
                @Html.DisplayFor(modelItem => item.DeptId)
            </td>
        </tr>
    }

</table>
@Html.ActionLink("Back to List", "DanhMucPhongBan")