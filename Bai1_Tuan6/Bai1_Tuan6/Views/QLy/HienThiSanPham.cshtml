@{
    ViewBag.Title = "HienThiSanPham";
    Layout = "~/Views/Shared/LayoutQuanLy.cshtml";
}

@using Bai1_Tuan6.Models;
@model List<SanPham>

<h2 class="text-center">Hiển Thị Sản Phẩm</h2>
<table class="table table-bordered">
    <tr class="thead-dark">
        <th>Mã Sản Phẩm</th>
        <th>Tên Sản Phẩm</th>
        <th>Đường dẫn</th>
        <th>Giá</th>
        <th>Mô Tả</th>
        <th>Mã loại</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.masp</td>
            <td>@item.tensp</td>
            <td>@item.duongdan</td>
            <td>@item.gia</td>
            <td>@item.mota</td>
            <td>@item.maloai</td>
        </tr>
    }
</table>