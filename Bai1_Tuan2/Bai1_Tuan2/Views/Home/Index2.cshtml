@{
    ViewBag.Title = "Index2";
}

<h2>DANH SÁCH TRÁI CÂY</h2>
@{
    if (ViewBag.tc == null)
    {
        <p>Danh sách rổng</p>
    }
    else
    {
        <ul>
            @foreach (var item in ViewBag.tc)
            {
                <li>@item</li>
            }
        </ul>
    }
}
