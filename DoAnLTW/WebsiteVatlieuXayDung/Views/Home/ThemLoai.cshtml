@model WebsiteVatlieuXayDung.Models.LOAIHANG

@{
    ViewBag.Title = "ThemLoai";
    Layout = "~/Views/Shared/LayoutWeb.cshtml";
}

<h2 class="text-center">Thêm Loại</h2>

<form action="/Home/ThemLoai" method="post" enctype="multipart/form-data">
    
    @Html.AntiForgeryToken()

    <div class="form-horizontal pl-5 pr-5">
        <h4>LOẠI HÀNG</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <label class="control-label" for="MALH">Mã Loại</label>
            @Html.EditorFor(model => model.MALH, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.MALH, "", new { @class = "text-danger" })
            <b class="text-danger">@ViewBag.loi</b>
        </div>

        <div class="form-group">
            <label class="control-label" for="TENLH">Tên Loại</label>
            @Html.EditorFor(model => model.TENLH, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TENLH, "", new { @class = "text-danger" })
        </div>

        <div class="form-group text-center">
            <input type="submit" value="Thêm" class="btn btn-danger" />
        </div>
    </div>
</form>

<div>
    @Html.ActionLink("Trở Lại Trang Danh Sách Loại", "DSLoai")
</div>
