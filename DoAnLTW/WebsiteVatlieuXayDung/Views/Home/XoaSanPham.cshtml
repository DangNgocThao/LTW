
@{
    ViewBag.Title = "XoaSanPham";
    Layout = "~/Views/Shared/LayoutWeb.cshtml";
}
@using WebsiteVatlieuXayDung.Models
@model HANGHOA

<div class="card card-body border-0 bg-light">
    <div class="container p-0">
        <div class="row bg-white pt-3">
            <div class="col-xl-4 d-none d-sm-block">
                <a>
                    <img width="350" height="350" src="/Images/@Model.HINHSANPHAM" alt="hinhsanpham" />
                </a>
            </div>
            <div class="col-xl-5">
                <div class="p-2">
                    <h3>@Model.TENHH <br />@Model.MAHH</h3>
                    <div class="d-none d-md-block">
                        <span>Đánh giá sản phẩm</span>
                        <div class="d-flex flex-row mb-3">
                            <div class="p-2">
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-regular fa-star-half-stroke"></i>
                                4.5/5
                            </div>
                            <div class="p-2">
                                18760 lượt xem
                            </div>
                        </div>
                    </div>
                    <div>
                        Địa điểm: "@Model.DIACHI"
                    </div>
                    <hr class="p-0" />
                    <div class="d-flex flex-column mb-3">
                        <p>Giá bán</p>
                        <p class="text-danger font-weight-bold">"@Model.GIA" đ</p>
                        <p class="h4">MÔ TẢ</p>
                        <p>"@Model.MOTA"</p>
                    </div>
                </div>
                <div class="row">
                    <h2 class="text-center mb-3 ml-4 text-danger">Bạn có chắc chắn muốn xóa?</h2>
                    <div class="col-5">
                        <form action="/Home/XuLyXoaSanPham/@Model.MAHH" method="post">
                            <button class="btn-primary btn p-2" ><h4>Đồng ý</h4></button>
                        </form>
                    </div>
                    <div class="col-6">
                        <form action="/Home/DSHang">
                            <button class="btn-primary btn p-2" ><h4>Quay về danh sách</h4></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>