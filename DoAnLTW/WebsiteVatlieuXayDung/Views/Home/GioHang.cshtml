@{
    ViewBag.Title = "GioHang";
    Layout = "~/Views/Shared/LayoutWeb.cshtml";
}
@using WebsiteVatlieuXayDung.Models;
@model List<Item>
<div class="bg-light col-12">
    <a href="/Home/DSHang">< Mua thêm sản phẩm khác</a>
    <a class="float-right" href="/Home/LichSuMuaHang">Lịch sử mua hàng</a>
</div>
@if (Model.Count == 0)
{
    <h3 class="text-center mt-4">Giỏ hàng trống!!</h3>
}
else
{
    <div class="container pl-5 pt-5">
        <form action="/Home/LuuSoLuongSP" method="post">
            <table class="table">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="w-25"><img src="~/Images/@item.hinhSanPham" style="width:200px;height:130px" /></td>
                        <td><p class="mt-5" style="color:orange">@item.gia</p></td>
                        <td><p class="mt-5">X</p></td>
                        <td width="10%"><input type="number" class="text-center w-100 mt-5" name="soLuong_@item.maHH" value="@item.soluong" min="1"></td>
                        <td><p class="mt-5">=</p></td>
                        <td><p class="mt-5" style="color:orange">@item.thanhTien</p></td>
                        <td><button style="cursor:pointer" class="border-0 bg-white mt-5 font-weight-bold"><a style="text-decoration:none" href="/Home/XoaSanPhamTrongGiohang/@item.maHH"><img src="~/Images/delete.png" /> Xóa</a></button></td>
                        <td><button style="cursor:pointer" type="submit" name="btn" value="@item.maHH" class="border-0 bg-white mt-5 font-weight-bold"><img src="~/Images/refresh.png" /> Lưu</button></td>
                    </tr>
                }
                <tr>
                    <td colspan="5">Tạm tính (@Model.Count sản phẩm):</td>
                    <td colspan="3"><b>@Model.Sum(x => x.gia * x.soluong) đ</b></td>
                </tr>
                <tr>
                    <td colspan="5" class="border-0"><b>Tổng tiền</b>:</td>
                    <td colspan="3" class="border-0"><b class="text-danger">@Model.Sum(x => x.gia * x.soluong) đ</b></td>
                </tr>
                <tr>
                    <td colspan="3"></td>
                    <td colspan="3">
                        @if (Session["kh"] != null)
                        {
                            <a class="font-weight-bold p-2 text-dark" href="/Home/XacNhanHang" style="background-color:darkorange">Tiếp tục</a>
                        }
                        else
                        {
                            <a class="font-weight-bold p-2 text-dark" href="/Home/BatBuocDangNhap" style="background-color:darkorange">Tiếp tục</a>
                        }
                    </td>
                    <td colspan="3"></td>
                </tr>
            </table>
        </form>
    </div>
}