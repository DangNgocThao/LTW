@model WebsiteVatlieuXayDung.Models.HANGHOA

@{
    ViewBag.Title = "SuaSanPham";
    Layout = "~/Views/Shared/LayoutWeb.cshtml";
}

<h2 class="text-center">Sửa Sản Phẩm</h2>

@using (Html.BeginForm("SuaSanPham", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal ml-5 mr-5">
        <h4>HÀNG HÓA</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.MAHH)

        <div class="form-group">
            <label class="control-label" for="MALH">Tên Loại</label>
            @Html.DropDownList("MALH", (IEnumerable<SelectListItem>)ViewBag.MALH, new { @class = "form-control text-box single-line" })
        </div>

        <div class="form-group">
            <label class="control-label" for="TENHH">Tên Hàng</label>
            @Html.EditorFor(model => model.TENHH, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TENHH, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label" for="MOTA">Mô Tả</label>
            @Html.EditorFor(model => model.MOTA, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.MOTA, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label" for="HINHSANPHAM">Hình Sản Phẩm</label>
            <input type="file" name="fileupload" class="form-control text-box single-line" id="HINHSANPHAM"/>
            @ViewBag.ThongBao
        </div>

        <div class="form-group">
            <label class="control-label" for="SOLUONG">Số Lượng</label>
            @Html.EditorFor(model => model.SOLUONG, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.SOLUONG, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label" for="GIA">Giá</label>
            @Html.EditorFor(model => model.GIA, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.GIA, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label" for="DIACHI">Địa Chỉ</label>
            @Html.EditorFor(model => model.DIACHI, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.DIACHI, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label" for="XUATXU">Xuất Xứ</label>
            @Html.EditorFor(model => model.XUATXU, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.XUATXU, "", new { @class = "text-danger" })
        </div>

        <div class="form-group text-center">
                <input type="submit" value="Lưu" class="btn btn-danger" />
        </div>
    </div>
}

<div>
    @Html.ActionLink("Trở Lại Trang Danh Sách Hàng", "DSHang")
</div>
